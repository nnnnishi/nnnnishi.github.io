---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for n in site.nav %}
  <url>
    <loc>{{ n.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
  </url>
  <url>
    <loc>{{ n.url | prepend: "/en" | absolute_url }}</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
  </url>
{%- endfor %}
{%- for u in site.sitemap_extra %}
  <url>
    <loc>{{ u | absolute_url }}</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
  </url>
{%- endfor %}
</urlset>
